# TAPP Pi Terminal — Environment Configuration
# Copy this file to .env and fill in your values.

# Database connection (same as backend/.env)
DB_HOST=sql63.jnb2.host-h.net
DB_PORT=3306
DB_NAME=digitcexse_db2
DB_USER=digitcexse_2
DB_PASSWORD=your_db_password

# Google Sheets Sync
# Set to 1 to enable syncing clock events to Google Sheets.
# The webhook URL is the Google Apps Script Web App URL from
# TAPP Admin → Settings → Google Sheets Sync.
GOOGLE_SHEETS_SYNC_ENABLED=1
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec